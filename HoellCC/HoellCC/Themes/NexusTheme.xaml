<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NEXUS Theme Colors -->

    <!-- Background Colors -->
    <Color x:Key="NxVoidColor">#0a0a0f</Color>
    <Color x:Key="NxDeepColor">#12121a</Color>
    <Color x:Key="NxSurfaceColor">#1f1f2e</Color>
    <Color x:Key="NxElevatedColor">#252538</Color>

    <!-- Accent Colors -->
    <Color x:Key="NxBlueColor">#4a9eff</Color>
    <Color x:Key="NxPurpleColor">#8b5cf6</Color>
    <Color x:Key="NxCyanColor">#06b6d4</Color>

    <!-- Text Colors -->
    <Color x:Key="NxTextPrimaryColor">#f0f4ff</Color>
    <Color x:Key="NxTextSecondaryColor">#a8b2d1</Color>
    <Color x:Key="NxTextMutedColor">#64748b</Color>

    <!-- Gold/Event Colors -->
    <Color x:Key="NxGoldColor">#FFD700</Color>
    <Color x:Key="NxGoldEndColor">#FF8C00</Color>

    <!-- Row Background Colors (with alpha) -->
    <Color x:Key="NxRowStartColor">#CC252538</Color>
    <Color x:Key="NxRowEndColor">#991f1f2e</Color>

    <!-- Border Colors -->
    <Color x:Key="NxBorderColor">#194a9eff</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="NxVoidBrush" Color="{StaticResource NxVoidColor}"/>
    <SolidColorBrush x:Key="NxDeepBrush" Color="{StaticResource NxDeepColor}"/>
    <SolidColorBrush x:Key="NxSurfaceBrush" Color="{StaticResource NxSurfaceColor}"/>
    <SolidColorBrush x:Key="NxElevatedBrush" Color="{StaticResource NxElevatedColor}"/>

    <SolidColorBrush x:Key="NxBlueBrush" Color="{StaticResource NxBlueColor}"/>
    <SolidColorBrush x:Key="NxPurpleBrush" Color="{StaticResource NxPurpleColor}"/>
    <SolidColorBrush x:Key="NxCyanBrush" Color="{StaticResource NxCyanColor}"/>

    <SolidColorBrush x:Key="NxTextPrimaryBrush" Color="{StaticResource NxTextPrimaryColor}"/>
    <SolidColorBrush x:Key="NxTextSecondaryBrush" Color="{StaticResource NxTextSecondaryColor}"/>
    <SolidColorBrush x:Key="NxTextMutedBrush" Color="{StaticResource NxTextMutedColor}"/>

    <SolidColorBrush x:Key="NxGoldBrush" Color="{StaticResource NxGoldColor}"/>
    <SolidColorBrush x:Key="NxBorderBrush" Color="{StaticResource NxBorderColor}"/>

    <!-- Gradient Brushes -->

    <!-- Blue to Purple Gradient (Horizontal - for platform strips) -->
    <LinearGradientBrush x:Key="NxBluePurpleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource NxBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxPurpleColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Blue to Purple Gradient (Vertical - for platform strips) -->
    <LinearGradientBrush x:Key="NxBluePurpleGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NxBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxPurpleColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gold Gradient (Horizontal - for event/gift strips) -->
    <LinearGradientBrush x:Key="NxGoldGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource NxGoldColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxGoldEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gold Gradient (Vertical - for event/gift strips) -->
    <LinearGradientBrush x:Key="NxGoldGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NxGoldColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxGoldEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Surface Gradient (Vertical - for row backgrounds) -->
    <LinearGradientBrush x:Key="NxSurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NxRowStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxRowEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Header Gradient -->
    <LinearGradientBrush x:Key="NxHeaderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource NxDeepColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxVoidColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Container Gradient (for events feed container) - 135deg diagonal -->
    <LinearGradientBrush x:Key="NxContainerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F21a1a24" Offset="0"/>
        <GradientStop Color="#E61f1f2e" Offset="1"/>
    </LinearGradientBrush>

    <!-- Hover Gradient (for event rows on hover) -->
    <LinearGradientBrush x:Key="NxHoverGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A4a9eff" Offset="0"/>
        <GradientStop Color="#1A8b5cf6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Username Gradient (for text foreground - simulating gradient text) -->
    <LinearGradientBrush x:Key="NxUsernameGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource NxBlueColor}" Offset="0"/>
        <GradientStop Color="{StaticResource NxPurpleColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Platform Row Background (matches .platform-row in HoellStream.css) -->
    <LinearGradientBrush x:Key="NxPlatformRowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#99252538" Offset="0"/>
        <GradientStop Color="#661f1f2e" Offset="1"/>
    </LinearGradientBrush>

    <!-- Stat Box Background (matches .stat in HoellStream.css) -->
    <SolidColorBrush x:Key="NxStatBoxBrush" Color="#4D252538"/>

    <!-- Stat Box Border -->
    <SolidColorBrush x:Key="NxStatBoxBorderBrush" Color="#144a9eff"/>

    <!-- Glow Effects -->
    <DropShadowEffect x:Key="NxGoldGlow"
                      Color="{StaticResource NxGoldColor}"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.6"/>

    <DropShadowEffect x:Key="NxBlueGlow"
                      Color="{StaticResource NxBlueColor}"
                      BlurRadius="12"
                      ShadowDepth="0"
                      Opacity="0.5"/>

    <DropShadowEffect x:Key="NxRowShadow"
                      Color="Black"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Opacity="0.3"/>

    <!-- Window Chrome Colors -->
    <Color x:Key="NxCloseHoverColor">#e74c3c</Color>
    <SolidColorBrush x:Key="NxCloseHoverBrush" Color="{StaticResource NxCloseHoverColor}"/>

    <!-- Window Control Button Style (Minimize/Maximize) -->
    <Style x:Key="NxWindowButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            Padding="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource NxBluePurpleGradient}"/>
                            <Setter Property="Foreground" Value="{StaticResource NxCyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource NxElevatedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Close Button Style (red hover) -->
    <Style x:Key="NxWindowCloseButton" TargetType="Button" BasedOn="{StaticResource NxWindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            Padding="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource NxBluePurpleGradient}"/>
                            <Setter Property="Foreground" Value="{StaticResource NxCyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{StaticResource NxElevatedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NEXUS ScrollBar Style (Thin, No Arrows, Gradient Thumb) -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NxBluePurpleGradient}"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Opacity="0.2"/>
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                Opacity="0.7"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource NxCyanBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Horizontal ScrollBar -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Opacity="0.2"/>
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBorder"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Opacity="0.7"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource NxCyanBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nexus Tooltip Style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource NxDeepBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxPurpleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status Indicator Colors -->
    <SolidColorBrush x:Key="NxConnectedBrush" Color="#2ecc71"/>
    <SolidColorBrush x:Key="NxDisconnectedBrush" Color="#e74c3c"/>

    <!-- Primary Action Button Style -->
    <Style x:Key="NxPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                            <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NxElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Test Action Button Style (smaller) -->
    <Style x:Key="NxTestButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource NxElevatedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Style -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="CaretBrush" Value="{StaticResource NxCyanBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource NxBlueBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource NxBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Toggle Button Template -->
    <ControlTemplate x:Key="NxComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Border"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource NxSurfaceBrush}"
                    BorderBrush="{StaticResource NxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"/>
            <Path x:Name="Arrow"
                  Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{StaticResource NxTextSecondaryBrush}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource NxBlueBrush}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource NxBlueBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource NxBlueBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ComboBox Style -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource NxComboBoxToggleButton}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="8,4,24,4"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource NxDeepBrush}"
                                        BorderBrush="{StaticResource NxBlueBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"/>
                                <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem Style -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox Style -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource NxDeepBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NxBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ListBoxItem Style -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            Margin="2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource NxSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource NxBluePurpleGradient}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Label Style -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource NxTextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Section Header Style -->
    <Style x:Key="NxSectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource NxTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

</ResourceDictionary>
